# ============================================
# CYBOTICS TAP — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local: postgresql://postgres:postgres@localhost:5432/cybotics_tap
# Production: Use your cloud PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybotics_tap

# --- URLs ---
# The public URL where the game is accessible (used for QR code generation)
# Local: http://localhost:5173
# Production: https://cybotics-tap.your-domain.com
PUBLIC_GAME_URL=http://localhost:5173

# The frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# --- Security ---
# Secret key for admin JWT tokens (change in production!)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Admin password for the admin panel
ADMIN_SECRET=cybotics-admin-2026

# --- Game Config ---
# Default number of rounds per game
DEFAULT_ROUNDS=20

# Default event name
DEFAULT_EVENT_NAME=CYBOTICS FAIR 2026

# --- Frontend build (Vercel project root: client) ---
# Set these in Vercel before deploying the frontend.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
VITE_SOCKET_URL=https://your-render-service.onrender.com
VITE_PUBLIC_GAME_URL=https://your-frontend-domain.example
